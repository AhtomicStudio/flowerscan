{
  "name": "flowerscan",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "pnpm --filter @flowerscan/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @flowerscan/web test:e2e",
    "vault:check": "pnpm --filter @flowerscan/vault-build check",
    "vault:build": "pnpm --filter @flowerscan/vault-build build-data"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:"
  }
}
